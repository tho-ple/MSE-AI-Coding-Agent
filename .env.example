# Copy to .env (git-ignored) and fill in. Never commit the real key.
#
# Option A: FH endpoint (OpenAI-compatible, Qwen3.6-35B-A3B on a GPU)
HARNESS_PROVIDER=openai
HARNESS_MODEL=Qwen/Qwen3.6-35B-A3B
OPENAI_BASE_URL=YOUR_ENDPOINT_URL
OPENAI_API_KEY=YOUR_API_KEY
#
# Option B: local Ollama (no key). Remove the four lines above and use:
# HARNESS_PROVIDER=ollama
# HARNESS_MODEL=qwen2.5-coder:14b
# OLLAMA_HOST=http://localhost:11434
